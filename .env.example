# Copy to `.env` and fill in real values, then restart the server.
# `.env` is git-ignored.

# ---------------------------------------------------------------- admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session signing key (generate with: python3 -c "import secrets;print(secrets.token_hex(32))")
# SECRET_KEY=

# --------------------------------------------------- Aadhaar OTP / SMS gateway
# Leave SMS_PROVIDER empty to stay in demo mode (no SMS is sent; the code is
# shown in the form and in the server log).
SMS_PROVIDER=

# Fast2SMS (India) — https://www.fast2sms.com
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=
# SMS_SENDER_ID=ASTRIM

# MSG91 — https://msg91.com (needs a DLT-approved template with an OTP variable)
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Twilio — https://www.twilio.com
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Set to 0 to stop echoing the OTP back to the browser in demo mode.
AADHAAR_DEMO_MODE=1
